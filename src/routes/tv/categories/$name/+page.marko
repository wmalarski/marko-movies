import { getTrendingTv, getTvShows } from "../../../../services/tmdb";
import { getListItem } from "../../../../utils/format";
import * as v from "valibot";
import { getNameValidation } from "../../../../utils/validation";
import Loader from "./loader.marko";
<const/parseResult=v.parse(
  v.object({ name: getNameValidation() }),
  $global.params,
)>
<const/name=parseResult.name>
<const/tvShows=(
  name === "trending"
    ? getTrendingTv({ context: $global.tmdb, page: 1 })
    : getTvShows({ context: $global.tmdb, page: 1, query: name })
)>

<await|data|=tvShows>
  <Loader
    initialCollection=data
    name=getListItem({ query: name, type: "tv" })
    categoryName=name/>
</await>
