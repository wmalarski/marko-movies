import { getMovies, getTrendingMovie } from "../../../../services/tmdb";
import { getListItem } from "../../../../utils/format";
import { object, string, minLength, pipe, parse } from "valibot";
<const/parseResult=parse(
  object({ name: pipe(string(), minLength(1)) }),
  $global.params,
)>
<const/name=parseResult.name>
<const/movies=(
  name === "trending"
    ? getTrendingMovie({ context: $global.tmdb, page: 1 })
    : getMovies({ context: $global.tmdb, page: 1, query: name })
)>

<await|data|=movies>
  <loader
    initialCollection=data
    name=getListItem({ query: parseResult.name, type: "movie" })
    categoryName=name/>
</await>
